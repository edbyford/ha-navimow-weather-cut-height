{#- Weather-aware cut-height decision. Mirrors reference/decision.py.
    Returns a JSON object string with keys:
    height, direction, reason, stress_days, steps_remaining, settle_days, can_act. -#}

{%- macro _down_step(current, target, step) -%}
  {%- set raw = current - (current // 3) -%}
  {%- set stepped = (((raw / step) | round(0, 'ceil')) * step) | int -%}
  {%- set stepped = (current - step) if stepped >= current else stepped -%}
  {{- [target, stepped] | max -}}
{%- endmacro -%}

{%- macro _steps_to_target(current, target, step) -%}
  {%- set ns = namespace(n=0, h=current) -%}
  {%- for _ in range(50) -%}
    {%- if ns.h > target -%}
      {%- set ns.h = _down_step(ns.h, target, step) | int -%}
      {%- set ns.n = ns.n + 1 -%}
    {%- endif -%}
  {%- endfor -%}
  {{- ns.n -}}
{%- endmacro -%}

{%- macro recommend_json(current, target, protective, forecast, now_iso, last_change_iso,
      heat_temp_c=26, dry_mm=1, cool_temp_c=22, wet_mm=2, window_days=5,
      cycle_days=1.5, coverage_cycles=2, recovery_buffer_days=2, height_step=5) -%}
  {%- set settle_days = (coverage_cycles * cycle_days + recovery_buffer_days) | round(0, 'ceil') | int -%}
  {%- if not forecast -%}
    {{- {"height": current, "direction": "idle", "reason": "forecast unavailable",
          "stress_days": 0, "steps_remaining": 0, "settle_days": settle_days,
          "can_act": false} | to_json -}}
  {%- else -%}
    {%- set window = forecast[:window_days] -%}
    {%- set ns = namespace(stress=0) -%}
    {%- for d in window -%}
      {%- if d.temperature is not none and d.temperature >= heat_temp_c
             and (d.precipitation | default(0)) < dry_mm -%}
        {%- set ns.stress = ns.stress + 1 -%}
      {%- endif -%}
    {%- endfor -%}
    {%- set days_since = ((as_timestamp(now_iso) - as_timestamp(last_change_iso)) / 86400) | int -%}
    {%- set settled = days_since >= settle_days -%}
    {%- if ns.stress > 0 and current < protective -%}
      {%- set height = [20, [95, protective] | min] | max | int -%}
      {%- set direction = "raise" -%}
      {%- set reason = "heat stress: " ~ ns.stress ~ " hot/dry day(s) in next " ~ window_days ~ "d" -%}
    {%- elif ns.stress == 0 and current > target and settled -%}
      {%- set height = [20, [95, _down_step(current, target, height_step) | int] | min] | max | int -%}
      {%- set direction = "lower" -%}
      {%- set reason = "calm week, step down toward target" -%}
    {%- elif ns.stress == 0 and current > target and not settled -%}
      {%- set height = current -%}{%- set direction = "hold" -%}
      {%- set reason = "settling, " ~ (settle_days - days_since) ~ "d to next step" -%}
    {%- elif current <= target -%}
      {%- set height = current -%}{%- set direction = "idle" -%}{%- set reason = "at target, calm" -%}
    {%- else -%}
      {%- set height = current -%}{%- set direction = "hold" -%}{%- set reason = "holding" -%}
    {%- endif -%}
    {{- {"height": height, "direction": direction, "reason": reason,
          "stress_days": ns.stress,
          "steps_remaining": _steps_to_target(height, target, height_step) | int,
          "settle_days": settle_days, "can_act": (height != current)} | to_json -}}
  {%- endif -%}
{%- endmacro -%}
